<Window x:Class="Практическая_работа_4_Козырь_Бредихин.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Практическая_работа_4_Козырь_Бредихин"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,0">
            <Button Content="Страница 1" Width="100" Margin="2"
                    Click="BtnPage1_Click"
                    ToolTip="Перейти на страницу 1"/>
            <Button Content="Страница 2" Width="100" Margin="2"
                    Click="BtnPage2_Click"
                    ToolTip="Перейти на страницу 2"/>
            <Button Content="Страница 3" Width="100" Margin="2"
                    Click="BtnPage3_Click"
                    ToolTip="Перейти на страницу 3"/>
        </StackPanel>
        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>

</Window>
