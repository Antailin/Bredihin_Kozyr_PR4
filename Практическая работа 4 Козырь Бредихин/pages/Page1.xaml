<Page x:Class="Практическая_работа_4_Козырь_Бредихин.pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Практическая_работа_4_Козырь_Бредихин.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">
    <StackPanel Background="#D4D0C8" Margin="0">

        <Border Background="White" BorderBrush="#999999" BorderThickness="1"
                Margin="10,10,10,8" Padding="20,12" Width="492" Height="113">
            <Image x:Name="FormulaImage"
                   Source="C:\Users\antai\source\repos\Практическая работа 4 Козырь Бредихин\Практическая работа 4 Козырь Бредихин\Images\formula1.png"
                   Stretch="Uniform"
                   MaxHeight="80"
                   HorizontalAlignment="Left"
                   ToolTip="Формула варианта 3"/>
        </Border>
        <Grid Margin="10,4,10,4" Height="116" Width="268">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>


            <Label Grid.Row="0" Grid.Column="0" Content="x"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Padding="0,0,6,0" FontSize="13"
                   ToolTip="Значение переменной x"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="TbX1"
                     VerticalAlignment="Center"
                     Padding="2,1" FontSize="13"
                     ToolTip="Введите значение x (вещественное число)"/>
            <Button Grid.Row="0" Grid.Column="3"
                    Content="Вычислить"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Click="BtnCalculate1_Click"
                    ToolTip="Вычислить значение функции v"/>
            <Label Grid.Row="1" Grid.Column="0" Content="y"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Padding="0,0,6,0" FontSize="13"
                   ToolTip="Значение переменной y (y ≠ 0)"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     x:Name="TbY1"
                     VerticalAlignment="Center"
                     Padding="2,1" FontSize="13"
                     ToolTip="Введите значение y (y ≠ 0)"/>
            <Label Grid.Row="2" Grid.Column="0" Content="z"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Padding="0,0,6,0" FontSize="13"
                   ToolTip="Значение переменной z (z ≠ 0)"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     x:Name="TbZ1"
                     VerticalAlignment="Center"
                     Padding="2,1" FontSize="13"
                     ToolTip="Введите значение z (z ≠ 0)"/>
            <Label Grid.Row="3" Grid.Column="0" Content="Ответ"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Padding="0,0,6,0" FontSize="13"
                   ToolTip="Результат вычисления"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     x:Name="TbResult1"
                     VerticalAlignment="Center"
                     Padding="2,1" FontSize="13"
                     IsReadOnly="True"
                     ToolTip="Результат вычисления функции v"/>
            <Button Grid.Row="3" Grid.Column="3"
                    Content="Очистить"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Click="BtnClear1_Click"
                    ToolTip="Очистить все поля"/>
        </Grid>

        <TextBlock x:Name="ErrorText1"
                   Foreground="Red" TextWrapping="Wrap"
                   Margin="10,4,10,4" FontSize="12"/>
    </StackPanel>

</Page>
