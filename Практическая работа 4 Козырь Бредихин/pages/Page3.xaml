<Page x:Class="Практическая_работа_4_Козырь_Бредихин.pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Практическая_работа_4_Козырь_Бредихин.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page3">

    <Grid Background="#D4D0C8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="10,10,6,10" Width="160">
            <Border Background="White" BorderBrush="#999999" BorderThickness="1"
                    Padding="10,8" Margin="0,0,0,8">
                <Image Source="C:\Users\antai\source\repos\Практическая работа 4 Козырь Бредихин\Практическая работа 4 Козырь Бредихин\Images\formula3.png"
                       Stretch="Uniform"
                       MaxHeight="80"
                       HorizontalAlignment="Left"
                       ToolTip="Формула варианта 3"/>
            </Border>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="x₀" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Padding="0,0,4,0" FontSize="13"
                       ToolTip="Начальное значение x₀"/>
                <TextBox Grid.Column="1" x:Name="TbX0" VerticalAlignment="Center"
                         Padding="2,1" FontSize="13"
                         ToolTip="Введите начальное значение x₀"/>
            </Grid>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="xₖ" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Padding="0,0,4,0" FontSize="13"
                       ToolTip="Конечное значение xₖ"/>
                <TextBox Grid.Column="1" x:Name="TbXk" VerticalAlignment="Center"
                         Padding="2,1" FontSize="13"
                         ToolTip="Введите конечное значение xₖ"/>
            </Grid>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="dx" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Padding="0,0,4,0" FontSize="13"
                       ToolTip="Шаг по x"/>
                <TextBox Grid.Column="1" x:Name="TbDx" VerticalAlignment="Center"
                         Padding="2,1" FontSize="13"
                         ToolTip="Шаг dx (≠ 0)"/>
            </Grid>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="a" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Padding="0,0,4,0" FontSize="13"
                       ToolTip="Параметр a"/>
                <TextBox Grid.Column="1" x:Name="TbA" VerticalAlignment="Center"
                         Padding="2,1" FontSize="13"
                         ToolTip="Введите параметр a"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="b" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Padding="0,0,4,0" FontSize="13"
                       ToolTip="Параметр b"/>
                <TextBox Grid.Column="1" x:Name="TbB" VerticalAlignment="Center"
                         Padding="2,1" FontSize="13"
                         ToolTip="Введите параметр b"/>
            </Grid>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="x" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Padding="0,0,4,0" FontSize="13"
                       ToolTip="Текущее начальное x"/>
                <TextBox Grid.Column="1" x:Name="TbXDisplay" VerticalAlignment="Center"
                         Padding="2,1" FontSize="13"
                         ToolTip="Отображает x₀"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Ответ" VerticalAlignment="Top"
                       HorizontalAlignment="Right" Padding="0,2,4,0" FontSize="13"
                       ToolTip="Список значений y"/>
                <TextBox Grid.Column="1" x:Name="TbResults3"
                         Height="100" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="13" Padding="2"
                         ToolTip="Значения y из цикла"/>
            </Grid>
            <Button Content="Вычислить" HorizontalAlignment="Left"
                    Width="80" Margin="40,4,0,2" FontSize="13"
                    Click="BtnCalculate3_Click"
                    ToolTip="Вычислить и построить график"/>
            <Button Content="Очистить" HorizontalAlignment="Left"
                    Width="80" Margin="40,2,0,0" FontSize="13"
                    Click="BtnClear3_Click"
                    ToolTip="Очистить результаты"/>
            <TextBlock x:Name="ErrorText3" Foreground="Red"
                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
        </StackPanel>
        <Border Grid.Column="1" Background="White" BorderBrush="#999999" BorderThickness="1"
                Margin="0,10,10,10">
            <Grid>
                <Canvas Height="20" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Width="80" Margin="0,6,10,0">
                    <Line X1="0" Y1="10" X2="24" Y2="10"
                          Stroke="SteelBlue" StrokeThickness="2"/>
                    <TextBlock Canvas.Left="28" Canvas.Top="2"
                               Text="Series1" FontSize="12"/>
                </Canvas>
                <Canvas x:Name="ChartCanvas" Margin="44,20,20,40"
                        SizeChanged="ChartCanvas_SizeChanged"/>
                <Canvas x:Name="AxisCanvas" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Page>


